{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"],

    "strict": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}